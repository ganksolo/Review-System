# ============================================================
# 交易复盘系统 — 根目录环境变量参考
# ============================================================
# 本文件仅供参考，实际环境变量在 Railway Dashboard 中配置。
# 本地开发请复制此文件到 backend/.env 或 frontend/.env.local

# ─── 后端 (backend/) ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_review_system
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000
LOG_LEVEL=INFO
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30
LLM_MAX_TOKENS=4096

# ─── 前端 (frontend/) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
